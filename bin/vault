#!/usr/bin/env python3
"""
vault: CLI unificada do vault Obsidian (Linux, macOS e Windows).

Uso: vault <comando> [argumentos]   (vault help lista os comandos)
"""
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN_DIR.parent / "lib"))
import vaultcfg  # noqa: E402

COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None
if os.name == "nt" and COLOR:
    os.system("")  # habilita sequências ANSI no console do Windows


def c(code, text):
    return f"\033[{code}m{text}\033[0m" if COLOR else text


CYAN, GREEN, YELLOW, RED, BOLD, DIM = "96", "92", "93", "91", "1", "2"

CFG = vaultcfg.load()
VAULT = Path(CFG["vault_dir"])
os.environ["OBSIDIAN_VAULT_PATH"] = str(VAULT)

COMMANDS = [
    ("status, info", "Resumo do vault: notas, canvases e estado do Git"),
    ("ingest <arquivo> [cat]", "Copia fonte bruta para 90 - Files/Sources e cria nota de síntese"),
    ("sources, backlog", "Fontes brutas pendentes e tarefas (vault-sources)"),
    ("lint", "Validação estrita + saúde do grafo"),
    ("validate", "Validador de integridade (vault-validate)"),
    ("health [--json]", "Notas órfãs, frescor e repositórios não catalogados (vault-health)"),
    ("search <termo>", "Busca textual"),
    ("meta <nota>", "Só o frontmatter YAML"),
    ("outline <nota>", "Cabeçalhos da nota"),
    ("section <nota> <seção>", "Só uma seção"),
    ("links <nota>", "WikiLinks de saída"),
    ("new <tipo> <nome> [opts]", "Nota nova a partir de 99 - Templates"),
    ("open [nota]", "Abre no Obsidian"),
    ("change [título]", "Change record (CHG-...)"),
    ("log <mensagem>", "Entrada no diário de hoje"),
    ("canvas", "Regenera os canvases de topologia"),
    ("sync-agents", "Instruções, skills e MCP dos agentes"),
    ("sync", "Valida, comita e envia o vault"),
    ("people sync", "Uma nota de pessoa por membro do time (layout.people_dir)"),
    ("backup [--list|--force|--restore f]", "Snapshot das configs de ~/.claude, ~/.gemini, ~/.agent(s), ~/.codex"),
    ("auth <setup|status|set>", "Credenciais Git: setup guiado, token no cofre do sistema, sem arquivo fixo"),
    ("help", "Esta ajuda"),
]


def banner():
    print(c(BOLD + ";" + CYAN, f"Obsidian Vault · {CFG['vault_name']}"))
    print(f"  {c(DIM, 'Vault:')} {VAULT}\n")


def show_help():
    banner()
    print(c(BOLD, "Uso:") + " vault <comando> [opções]\n")
    for cmd, desc in COMMANDS:
        print(f"  {c(CYAN, cmd.ljust(26))}{desc}")
    print()


def run_tool(name, *args):
    """Roda outra ferramenta deste repositório com o mesmo interpretador."""
    return subprocess.call([sys.executable, "-X", "utf8", str(BIN_DIR / name), *args])


def walk_md():
    for root, dirs, files in os.walk(VAULT):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
        for f in files:
            if f.endswith(".md"):
                yield Path(root) / f


def resolve_note(target):
    p = Path(target)
    if p.is_absolute() and p.exists():
        return p
    if (VAULT / target).exists():
        return VAULT / target
    clean = target[:-3] if target.endswith(".md") else target
    files = list(walk_md())
    for f in files:
        if f.stem.lower() == clean.lower():
            return f
    for f in files:
        if clean.lower() in f.name.lower():
            return f
    sys.exit(c(RED, f'Erro: nota "{target}" não encontrada no vault.'))


def rel(p):
    return Path(p).relative_to(VAULT).as_posix()


def need(args, n, usage):
    if len(args) < n:
        sys.exit(c(RED, "Erro: argumentos insuficientes.") + f"\nUso: {usage}")


def git(*args):
    return subprocess.run(["git", "-C", str(VAULT), *args], capture_output=True, text=True)


def cmd_status(_):
    banner()
    notes = sum(1 for _ in walk_md())
    canvases = sum(1 for _ in VAULT.rglob("*.canvas") if not any(x.startswith(".") for x in _.relative_to(VAULT).parts))
    branch = git("branch", "--show-current").stdout.strip() or "N/A"
    dirty = [l for l in git("status", "--short").stdout.splitlines() if l.strip()]
    print(c(BOLD, "Estatísticas:"))
    print(f"  • Notas Markdown: {c(BOLD, notes)}")
    print(f"  • Canvases: {c(BOLD, canvases)}")
    print(f"  • Branch Git: {c(GREEN, branch)}")
    print("  • Estado Git: " + (c(GREEN, "working tree limpa") if not dirty else c(YELLOW, f"{len(dirty)} arquivo(s) não comitados")))
    print()


def cmd_lint(args):
    print(c(BOLD, "[1/2] Validação estrita"))
    rc = run_tool("vault-validate", str(VAULT))
    print(c(BOLD, "\n[2/2] Saúde do grafo"))
    return rc or run_tool("vault-health", *args)


def cmd_ingest(args):
    need(args, 1, "vault ingest <arquivo> [categoria]")
    src = Path(args[0])
    category = args[1] if len(args) > 1 else "General"
    if not src.is_file():
        sys.exit(c(RED, f"Erro: arquivo '{src}' não encontrado."))
    dest_dir = VAULT / "90 - Files" / "Sources" / category
    dest_dir.mkdir(parents=True, exist_ok=True)
    shutil.copy2(src, dest_dir / src.name)
    today = datetime.now().strftime("%Y-%m-%d")
    ingest_org = vaultcfg.default_org(CFG)
    research_dir = VAULT / "14 - Research" / ingest_org if vaultcfg.org_subfolders(CFG) else VAULT / "14 - Research"
    research_dir.mkdir(parents=True, exist_ok=True)
    synthesis = research_dir / f"{src.stem} - Sintese e Analise.md"
    raw_rel = f"90 - Files/Sources/{category}/{src.name}"
    if not synthesis.exists():
        synthesis.write_text(f"""---
type: research
name: {src.stem} - Síntese e Análise
topic: {category}
source_type: ingest
raw_source: {raw_rel}
organization: {ingest_org}
project: {ingest_org}
date: {today}
ingested_by: Operator & AI Agent
status: active
last_verified: {today}
---

# {src.stem} · Síntese e Análise

> [!NOTE]
> **Fonte bruta:** [[{raw_rel}|{src.name}]]
> **Categoria:** {category} | **Ingestão:** {today}

## 1. Sumário e tese principal

[Síntese compilada]

## 2. Conhecimento extraído

- [Ponto 1]

## 3. Conexões no vault

- [[Cross-Organization]]

## 4. Próximas ações

- [ ] Revisão detalhada
""", encoding="utf-8")
    print(c(GREEN, "✓ Fonte bruta copiada para:") + f" {raw_rel}")
    print(c(GREEN, "✓ Nota de síntese:") + f" {rel(synthesis)}")
    cmd_log([f"Ingestão de fonte primária '{src.name}' ({category}) em [[{raw_rel}]] e nota [[{rel(synthesis)}]]"], quiet=True)
    open_in_obsidian(rel(synthesis), launch=False)


def cmd_search(args):
    if args and args[0] in ("-s", "--semantic"):
        args = args[1:]
        print(c(YELLOW, "Busca neural desativada por política de desempenho; usando busca textual.\n"))
    need(args, 1, "vault search <termo>")
    query = " ".join(args)
    pat = re.compile(re.escape(query), re.IGNORECASE)
    print(c(BOLD, f"Buscando '{query}' no vault...\n"))
    hits = 0
    for f in walk_md():
        try:
            lines = f.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for n, line in enumerate(lines, 1):
            if pat.search(line):
                print(f"{c(GREEN, f'[[{rel(f)}]]:{n}')} {line.strip()[:200]}")
                hits += 1
                if hits >= 25:
                    return
    print()


TYPE_MAP = {
    "server": ("04 - Servers", "Server.md", True), "srv": ("04 - Servers", "Server.md", True),
    "service": ("05 - Services", "Service.md", True), "svc": ("05 - Services", "Service.md", True),
    "application": ("06 - Applications", "Application.md", True), "app": ("06 - Applications", "Application.md", True),
    "project": ("02 - Projects", "Project.md", True),
    "repository": ("03 - Repositories", "Repository.md", True), "repo": ("03 - Repositories", "Repository.md", True),
    "procedure": ("10 - Procedures", "Procedure.md", True), "sop": ("10 - Procedures", "Procedure.md", True),
    "runbook": ("10 - Procedures", "Procedure.md", True),
    "decision": ("12 - Decisions", "Decision.md", False), "adr": ("12 - Decisions", "Decision.md", False),
    "research": ("14 - Research", "Research.md", True),
    "person": ("15 - People", "Person.md", True),
    "tool": ("16 - Tools", "Tool.md", True),
}


def cmd_new(args):
    usage = "vault new <" + "|".join(sorted(TYPE_MAP)) + "> <nome> [--org O] [--server S] [--project P] [--env E] [--status S]"
    need(args, 2, usage)
    etype, name = args[0].lower(), args[1]
    # Vault com uma única organização (vault de time): ela é o padrão, sem exigir --org.
    opts = {"org": vaultcfg.default_org(CFG),
            "server": "", "project": "", "env": "production", "status": "active"}
    rest = args[2:]
    for i in range(0, len(rest) - 1, 2):
        key = rest[i].lstrip("-")
        if key in opts:
            opts[key] = rest[i + 1]
    if etype not in TYPE_MAP:
        sys.exit(c(RED, f'Erro: tipo "{etype}" desconhecido.') + f"\nUso: {usage}")
    folder, template, by_org = TYPE_MAP[etype]
    tpl = VAULT / "99 - Templates" / template
    if not tpl.is_file():
        sys.exit(c(RED, f"Erro: template {tpl} não encontrado."))
    orgs = vaultcfg.organizations(CFG) + ["Cross-Organization"]
    org = next((o for o in orgs if o.lower() == opts["org"].lower()), opts["org"])
    today = datetime.now().strftime("%Y-%m-%d")
    if etype == "person" and vaultcfg.people_dir(CFG):
        folder, by_org = CFG["layout"]["people_dir"], False
    use_org_dir = by_org and vaultcfg.org_subfolders(CFG) and orgs != ["Cross-Organization"]
    dest_dir = VAULT / folder / org if use_org_dir else VAULT / folder
    if vaultcfg.date_sub(CFG, folder, today):
        dest_dir = dest_dir / vaultcfg.date_sub(CFG, folder, today)
    dest_dir.mkdir(parents=True, exist_ok=True)
    clean = re.sub(r'[/\\?%*:|"<>]', "-", name).strip()
    if etype in ("decision", "adr"):
        prefix = f"ADR-{today}-" + (f"{vaultcfg.author(CFG)}-" if CFG.get("change_id_author") else "")
        existing = [int(m.group(1)) for f in dest_dir.iterdir() if (m := re.match(re.escape(prefix) + r"(\d{3})", f.name))]
        seq = f"{(max(existing) if existing else 0) + 1:03d}"
        file_name = f"{prefix}{seq} - {clean}.md"
    else:
        file_name = f"{clean}.md"
    dest = dest_dir / file_name
    if dest.exists():
        print(c(YELLOW, f"Aviso: [[{rel(dest)}]] já existe."))
        return
    content = tpl.read_text(encoding="utf-8")
    repl = {"name": clean, "organization": org, "project": opts["project"] or f"{org} Project",
            "server": opts["server"] or "srv-host", "environment": opts["env"], "status": opts["status"],
            "criticality": "medium", "last_verified": today, "date": today}
    for k, v in repl.items():
        content = content.replace("{{" + k + "}}", v)
    for k, v in (("name", clean), ("organization", org), ("environment", opts["env"]), ("status", opts["status"]),
                 ("last_verified", today), ("date", today), ("project", opts["project"]), ("server", opts["server"])):
        if v:
            # Sobrescreve também valor antigo do template (ex.: organização de outro time).
            content = re.sub(rf"(?m)^{k}:[ \t]*.*$", lambda _m, k=k, v=v: f"{k}: {v}", content)
    dest.write_text(content, encoding="utf-8")
    print(c(GREEN, f"✓ Nota criada a partir de {template}:") + f" [[{rel(dest)}]]")


def _token_source(rule, url):
    """Onde o token está hoje: variável, arquivo, cofre do git ou None."""
    if rule.get("token_env") and os.environ.get(rule["token_env"], "").strip():
        return "variável " + rule["token_env"]
    if rule.get("token_file") and Path(rule["token_file"]).expanduser().is_file() \
            and Path(rule["token_file"]).expanduser().read_text(encoding="utf-8").strip():
        return "arquivo"
    return "cofre do git" if vaultcfg._credential_helper_token(url, rule.get("user", "oauth2")) else None


def _suggest_helper():
    if sys.platform.startswith("win"):
        return "manager"
    if sys.platform == "darwin":
        return "osxkeychain"
    for d in ("/usr/lib/git-core", "/usr/libexec/git-core", "/usr/lib/git"):
        if (Path(d) / "git-credential-libsecret").is_file():
            return "libsecret"
    return None


def _git_cfg(*a):
    return subprocess.run(["git", "config", *a], capture_output=True, text=True).stdout.strip()


def cmd_auth_setup(args):
    """Prepara as credenciais Git do vault. Sem TTY (agente) só diagnostica e diz o que o operador deve rodar."""
    check = "--check" in args
    interactive = sys.stdin.isatty() and not check
    rules = CFG.get("git_https_auth", [])
    missing = 0
    print(c(BOLD, "1. Cofre de credenciais do git"))
    helper = _git_cfg("--get", "credential.helper")
    if helper:
        print(c(GREEN, f"  ✓ credential.helper = {helper}"))
    else:
        sug = _suggest_helper()
        if not sug:
            print(c(YELLOW, "  ! Nenhum credential helper seguro disponível neste Linux. Instale git-credential-libsecret "
                            "(pacote libsecret-tools/git) ou use token_env/token_file na regra git_https_auth."))
        elif interactive and input(f"  Nenhum helper configurado. Ativar '{sug}' (git config --global)? [S/n] ").strip().lower() in ("", "s", "y"):
            _git_cfg("--global", "credential.helper", sug)
            print(c(GREEN, f"  ✓ credential.helper = {sug}"))
        else:
            print(c(YELLOW, f"  ! Sem helper. Ative com: git config --global credential.helper {sug}"))
    print(c(BOLD, "\n2. Tokens por host (git_https_auth)"))
    if not rules:
        print(c(YELLOW, "  Nenhuma regra. Adicione ao .vault/config.json, por exemplo:"))
        print('    "git_https_auth": [{"host_contains": "git.example.com", "user": "oauth2"}]')
    for rule in rules:
        host = rule.get("host_contains", "")
        url = f"https://{host}/"
        src = _token_source(rule, url)
        if src:
            print(c(GREEN, f"  ✓ {host}: token disponível ({src})"))
            if src != "cofre do git" and interactive and _git_cfg("--get", "credential.helper") and \
                    input("    Guardar também no cofre do git, para não depender deste arquivo/variável? [s/N] ").strip().lower() in ("s", "y"):
                tok = vaultcfg.resolve_token(rule, url)
                print(c(GREEN, "    ✓ guardado") if vaultcfg.store_credential(url, tok, rule.get("user", "oauth2")) else c(RED, "    ✗ falhou"))
            continue
        if interactive:
            import getpass
            print(f"  {host}: sem token. Crie um token de acesso pessoal no GitLab (escopos read_repository e write_repository).")
            tok = getpass.getpass("    Cole o token (não aparece na tela; Enter para pular): ").strip()
            if tok and vaultcfg.store_credential(url, tok, rule.get("user", "oauth2")) and \
                    vaultcfg._credential_helper_token(url, rule.get("user", "oauth2")):
                print(c(GREEN, f"  ✓ {host}: token guardado e verificado"))
                continue
            print(c(RED, f"  ✗ {host}: token não guardado"))
        else:
            print(c(RED, f"  ✗ {host}: sem token"))
        missing += 1
    print(c(BOLD, "\n3. GitHub CLI"))
    if shutil.which("gh"):
        gh = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
        if gh.returncode == 0:
            print(c(GREEN, "  ✓ gh autenticado"))
        else:
            print(c(YELLOW, "  ! gh sem login (só importa se usar GitHub). Rode num terminal: gh auth login"))
    else:
        print(c(YELLOW, "  - gh não instalado (necessário só se usar GitHub: https://cli.github.com)"))
    if missing:
        print(c(BOLD, "\nPróximo passo (rode você mesmo num terminal, o agente não deve ver o token):"))
        print("  vault auth setup   (GitLab/cofre)   e   gh auth login   (GitHub)")
        return 1
    print(c(GREEN, "\nCredenciais prontas."))
    return 0


def cmd_auth(args):
    """vault auth setup [--check] | status | set <host>: token via cofre de credenciais do git."""
    sub = args[0] if args else "status"
    rules = CFG.get("git_https_auth", [])
    if sub == "setup":
        return cmd_auth_setup(args[1:])
    if sub == "status":
        if not rules:
            print("Nenhuma regra git_https_auth configurada.")
        for rule in rules:
            host = rule.get("host_contains", "")
            src = _token_source(rule, f"https://{host}/")
            print(f"{host}: " + (c(GREEN, f"token disponível ({src})") if src else c(RED, "sem token. Rode: vault auth setup")))
        return 0
    if sub == "set":
        need(args, 2, "vault auth set <host>")
        host = args[1]
        rule = next((r for r in rules if r.get("host_contains") == host), {"user": "oauth2"})
        import getpass
        token = getpass.getpass(f"Token de acesso para {host} (não aparece na tela): ").strip()
        if not token:
            sys.exit(c(RED, "Token vazio."))
        if vaultcfg.store_credential(f"https://{host}/", token, rule.get("user", "oauth2")):
            print(c(GREEN, "✓ Token guardado no cofre de credenciais do git (Git Credential Manager, Keychain ou libsecret)."))
            return 0
        sys.exit(c(RED, "Falha ao guardar. Rode: vault auth setup"))
    sys.exit(c(RED, "Uso: vault auth <setup [--check]|status|set <host>>"))


def cmd_meta(args):
    need(args, 1, "vault meta <nota>")
    p = resolve_note(args[0])
    m = re.search(r"(?s)^---\r?\n(.*?)\r?\n---", p.read_text(encoding="utf-8", errors="replace"))
    if m:
        print(f"# [[{rel(p)}]] (Frontmatter YAML)\n---\n{m.group(1).strip()}\n---")
    else:
        print(f"Nenhum frontmatter YAML em [[{rel(p)}]].")


def cmd_outline(args):
    need(args, 1, "vault outline <nota>")
    p = resolve_note(args[0])
    heads = re.findall(r"(?m)^(#{1,6}\s+.*)", p.read_text(encoding="utf-8", errors="replace"))
    print(f"# [[{rel(p)}]] (Outline)")
    print("\n".join(heads) if heads else "(nenhum cabeçalho)")


def cmd_section(args):
    need(args, 2, "vault section <nota> <seção>")
    p = resolve_note(args[0])
    wanted = " ".join(args[1:]).strip().lower()
    found, level, out = False, 0, []
    for line in p.read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.match(r"^(#{1,6})\s+(.*)", line)
        if m:
            lvl, text = len(m.group(1)), m.group(2).strip()
            if not found and wanted in text.lower():
                found, level = True, lvl
                out.append(line)
                continue
            if found and lvl <= level:
                break
        if found:
            out.append(line)
    if not found:
        sys.exit(f'Seção "{" ".join(args[1:])}" não encontrada em [[{rel(p)}]].')
    print(f'# [[{rel(p)}]] → Seção: "{" ".join(args[1:])}"\n')
    print("\n".join(out).strip())


def cmd_links(args):
    need(args, 1, "vault links <nota>")
    p = resolve_note(args[0])
    links = sorted(set(re.findall(r"\[\[(.*?)\]\]", p.read_text(encoding="utf-8", errors="replace"))))
    print(f"# [[{rel(p)}]] ({len(links)} WikiLinks de saída):")
    for l in links:
        print(f"- [[{l}]]")


def obsidian_cli():
    return shutil.which("obsidian-cli") or shutil.which("obsidian")


def open_in_obsidian(note, launch=True):
    """Abre via obsidian-cli quando existe; senão usa o URI obsidian:// do sistema."""
    cli = shutil.which("obsidian-cli")
    if cli:
        if subprocess.call([cli, "open", f"file={note}"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
            return
    if not launch:
        return
    from urllib.parse import quote
    uri = f"obsidian://open?vault={quote(VAULT.name)}&file={quote(note)}"
    if sys.platform == "darwin":
        subprocess.call(["open", uri])
    elif os.name == "nt":
        os.startfile(uri)  # noqa: S606
    else:
        subprocess.call(["xdg-open", uri], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def cmd_open(args):
    note = args[0] if args else "00 - Dashboard"
    print(c(CYAN, f"Abrindo '{note}' no Obsidian..."))
    open_in_obsidian(note)


def write_change(title, server, service, project, risk, desc, agent="Operator CLI"):
    today = datetime.now().strftime("%Y-%m-%d")
    cid, year_dir = vaultcfg.next_change_id(CFG, today)
    year_dir.mkdir(parents=True, exist_ok=True)
    clean = re.sub(r'[/\\?%*:|"<>]', "-", title).strip()
    path = year_dir / f"{cid} - {clean}.md"
    link = lambda v: f"[[{v}]]" if v else "-"  # noqa: E731
    author_line = f"author: {vaultcfg.author(CFG)}\n" if CFG.get("change_id_author") else ""
    who_link = vaultcfg.author_link(CFG)
    who_line = f"- **Autor:** {who_link}\n" if who_link else ""
    path.write_text(f"""---
type: change
id: {cid}
date: {today}
server: {server}
service: {service}
project: {project}
{author_line}agent: {agent}
risk: {risk}
status: completed
environment: local
---

# {cid} - {clean}

## Metadados

- **ID:** `{cid}`
- **Data:** `{today}`
{who_line}- **Projeto:** {link(project)}
- **Servidor:** {link(server)}
- **Serviço:** {link(service)}
- **Risco:** `{risk}`
- **Status:** `completed`

## 1. Motivação e Descrição

{desc}

## 2. Alterações Realizadas

- [x] {desc}

## 3. Validação

- [x] Verificado pelo operador
""", encoding="utf-8")
    return cid, path


def cmd_change(args):
    title = " ".join(args) or input("Título da mudança: ").strip()
    if not title:
        sys.exit(c(RED, "Erro: título obrigatório."))
    ask = lambda q, d: input(f"{q} [{d}]: ").strip() or d  # noqa: E731
    server = ask("Servidor afetado", CFG.get("default_change_server", ""))
    service = ask("Serviço afetado", "")
    project = ask("Projeto afetado", "Cross-Organization")
    risk = ask("Risco (low/medium/high)", "low")
    desc = ask("Descrição", "Intervenção técnica realizada.")
    cid, path = write_change(title, server, service, project, risk, desc)
    print(c(GREEN, "✓ Change criada:") + f" [[{rel(path)}]] ({cid})")


def cmd_log(args, quiet=False):
    need(args, 1, "vault log <mensagem>")
    now = datetime.now()
    date_str, time_str = now.strftime("%Y-%m-%d"), now.strftime("%H:%M")
    f = vaultcfg.journal_file(CFG, date_str)
    f.parent.mkdir(parents=True, exist_ok=True)
    if not f.exists():
        jtype = CFG["journal"].get("type", "meeting")
        who = vaultcfg.author(CFG) if CFG["journal"].get("per_author") else ""
        title = f"Diário {who} {date_str}".replace("  ", " ") if who else f"Daily Log {date_str}"
        author_line = f"author: {who}\n" if who else ""
        who_link = vaultcfg.author_link(CFG) if who else ""
        link_line = f"\nAutor: {who_link}\n" if who_link else ""
        f.write_text(f"---\ntype: {jtype}\ntitle: {title}\ndate: {date_str}\n{author_line}status: completed\n---\n\n# {title}\n{link_line}", encoding="utf-8")
    with f.open("a", encoding="utf-8") as fh:
        fh.write(f"\n### [{time_str}] Atividade Operacional\n\n{' '.join(args)}\n")
    if not quiet:
        print(c(GREEN, f"✓ Entrada adicionada em [[{rel(f)}]] às {time_str}."))


AUTHORS_SKIP = ("99 - Templates", "90 - Files", "00 - Dashboard", "13 - Journal", "08 - Changes", ".obsidian", ".git",
                ".vault", ".obsidian-config", ".github", ".claude", ".gemini")


def add_authors(text, names):
    """Acrescenta `authors:` (links para as pessoas) ao frontmatter, sem remover quem já está."""
    m = re.match(r"(?s)---\r?\n(.*?)\r?\n---", text)
    if not m:
        return text
    fm = m.group(1)
    missing = [n for n in names if f"[[{n}]]" not in fm]
    if not missing:
        return text
    items = "".join(f'\n  - "[[{n}]]"' for n in missing)
    km = re.search(r"(?m)^authors:[ \t]*$", fm)
    if km:
        end = km.end()
        rest = re.match(r"(?:\n[ \t]+-[^\n]*)*", fm[end:]).group(0)
        fm2 = fm[:end] + rest + items + fm[end + len(rest):]
    elif re.search(r"(?m)^authors:", fm):
        return text  # formato inline do usuário: não mexe
    else:
        fm2 = fm + "\nauthors:" + items
    return text[:m.start(1)] + fm2 + text[m.end(1):]


def person_for_git_name(name, create):
    pdir = vaultcfg.people_dir(CFG)
    slug = vaultcfg.slugify(name)
    found = vaultcfg.find_person(CFG, slug)
    if found or not create:
        return found.stem if found else ""
    clean = re.sub(r'[/\\?%*:|"<>]', "-", name).strip()
    note = pdir / f"{clean}.md"
    if not note.exists():
        note.write_text(vaultcfg.person_note_text(CFG, clean, slug), encoding="utf-8")
        print(c(GREEN, "✓ Criada:") + f" [[{rel(note)}]]")
        print(c(YELLOW, f"  Se '{name}' (nome no git) for alguém que já tem nota, apague esta e acrescente `git_authors: [{slug}]` na nota existente."))
    return note.stem


def cmd_people(args):
    """vault people sync: uma nota de pessoa por membro (autores dos diários e seções das notas de time)."""
    if (args[:1] or ["sync"])[0] != "sync":
        sys.exit(c(RED, "Uso: vault people sync [--staged]"))
    pdir = vaultcfg.people_dir(CFG)
    if not pdir:
        sys.exit(c(RED, 'Defina "layout": {"people_dir": "15 - Team"} em .vault/config.json.'))
    pdir.mkdir(parents=True, exist_ok=True)
    if "--staged" in args:
        return people_stage_authors()
    created = []
    # 1. Autores: pastas do diário por autor e o autor atual.
    j = CFG["journal"]
    slugs = {vaultcfg.author(CFG)}
    jdir = VAULT / j["dir"]
    if j.get("per_author") and jdir.is_dir():
        slugs |= {d.name for d in jdir.iterdir() if d.is_dir()}
    git_names = {}
    for n in git("log", "--format=%an").stdout.splitlines():
        git_names.setdefault(vaultcfg.slugify(n), n)
    for slug in sorted(slugs):
        if vaultcfg.find_person(CFG, slug):
            continue
        name = re.sub(r'[/\\?%*:|"<>]', "-", git_names.get(slug, slug)).strip()
        note = pdir / f"{name}.md"
        if note.exists():
            continue
        note.write_text(vaultcfg.person_note_text(CFG, name, slug), encoding="utf-8")
        created.append(rel(note))
    # 2. Notas de time com uma seção "## Nome" por membro viram uma nota por pessoa.
    for team in sorted(pdir.glob("*.md")):
        text = team.read_text(encoding="utf-8")
        if vaultcfg._frontmatter_field(text, "type") != "team":
            continue
        parts = re.split(r"(?m)^## ", text)
        if len(parts) < 2:
            continue
        bullets = []
        if all(sec.partition("\n")[0].strip() == "Membros" for sec in parts[1:]):
            continue  # já convertida: só a lista de membros
        for sec in parts[1:]:
            name, _, body = sec.partition("\n")
            name = name.strip()
            if name == "Membros":
                bullets += [l for l in body.splitlines() if l.strip().startswith("- [[")]
                continue
            m = re.search(r"\*\*Papel:\*\*\s*(.+)", body)
            role = m.group(1).strip().rstrip(".") if m else ""
            note = pdir / f"{name}.md"
            if not note.exists():
                slug = next((sl for sl, gn in git_names.items() if sl == vaultcfg.slugify(name)), "")
                note.write_text(vaultcfg.person_note_text(CFG, name, slug or vaultcfg.slugify(name), body, role), encoding="utf-8")
                created.append(rel(note))
            bullets.append(f"- [[{name}]]" + (f": {role}" if role else ""))
        team.write_text(parts[0].rstrip() + "\n\n## Membros\n\n" + "\n".join(bullets) + "\n", encoding="utf-8")
    # 3. Liga diários e changes existentes à pessoa autora (idempotente).
    linked = 0
    def link_notes(files, slug_of, patch):
        nonlocal linked
        for f in files:
            slug = slug_of(f)
            person = vaultcfg.find_person(CFG, slug) if slug else None
            if not person:
                continue
            text = f.read_text(encoding="utf-8")
            if f"[[{person.stem}]]" in text:
                continue
            new = patch(text, person.stem)
            if new != text:
                f.write_text(new, encoding="utf-8")
                linked += 1
    if j.get("per_author") and jdir.is_dir():
        link_notes(sorted(jdir.rglob("*.md")), lambda f: f.relative_to(jdir).parts[0] if len(f.relative_to(jdir).parts) > 1 else "",
                   lambda t, n: re.sub(r"(?m)^(# .*)$", lambda m: f"{m.group(1)}\n\nAutor: [[{n}]]", t, count=1))
    cdir = VAULT / "08 - Changes"
    if cdir.is_dir():
        def change_author(f):
            m = re.search(r"(?m)^author:\s*(\S+)", f.read_text(encoding="utf-8").split("---", 2)[1] if f.read_text(encoding="utf-8").startswith("---") else "")
            return m.group(1) if m else ""
        link_notes(sorted(cdir.rglob("*.md")), change_author,
                   lambda t, n: re.sub(r"(?m)^(- \*\*Data:\*\*.*)$", lambda m: f"{m.group(1)}\n- **Autor:** [[{n}]]", t, count=1))
    # 4. Toda nota de conteúdo cita, em `authors:`, quem a escreveu (histórico do git).
    skip = (pdir.relative_to(VAULT).as_posix(),) + AUTHORS_SKIP
    by_file, cur = {}, ""
    for line in git("log", "--reverse", "--format=@@%an", "--name-only", "-M").stdout.splitlines():
        if line.startswith("@@"):
            cur = line[2:]
        elif line.strip() and cur:
            by_file.setdefault(line.strip(), [])
            if cur not in by_file[line.strip()]:
                by_file[line.strip()].append(cur)
    tagged = 0
    for f in sorted(VAULT.rglob("*.md")):
        r = rel(f)
        if r.startswith(skip) or ("/" not in r and r.upper().startswith(("AGENTS", "CLAUDE", "GEMINI", "README"))):
            continue
        names = [person_for_git_name(n, True) for n in by_file.get(r, [])]
        names = [n for n in names if n]
        if not names:
            continue
        text = f.read_text(encoding="utf-8")
        new = add_authors(text, names)
        if new != text:
            f.write_text(new, encoding="utf-8")
            tagged += 1
    if tagged:
        print(c(GREEN, f"✓ {tagged} nota(s) com `authors:` atualizado."))
    if linked:
        print(c(GREEN, f"✓ {linked} nota(s) ligada(s) à pessoa autora."))
    for r in created:
        print(c(GREEN, "✓ Criada:") + f" [[{r}]]")
    print(c(GREEN, f"{len(created)} nota(s) de pessoa criada(s).") if created else "Todos os membros já têm nota.")


def people_stage_authors():
    """Pre-commit: acrescenta o autor atual em `authors:` das notas staged (sem tocar em edição não staged)."""
    me = vaultcfg.ensure_person(CFG)
    if not me:
        return 0
    pdir = vaultcfg.people_dir(CFG).relative_to(VAULT).as_posix()
    unstaged = set(git("diff", "--name-only").stdout.splitlines())
    changed = []
    for r in git("-c", "core.quotepath=false", "diff", "--cached", "--name-only", "--diff-filter=AM").stdout.splitlines():
        if not r.endswith(".md") or r.startswith((pdir, *AUTHORS_SKIP)) or r in unstaged:
            continue
        f = VAULT / r
        text = f.read_text(encoding="utf-8")
        new = add_authors(text, [me])
        if new != text:
            f.write_text(new, encoding="utf-8")
            changed.append(r)
    pn = rel(vaultcfg.find_person(CFG, vaultcfg.author(CFG)))
    if changed or git("status", "--porcelain", "--", pn).stdout.strip():
        git("add", "--", *changed, pn)
    return 0


def cmd_sync(_):
    print(c(BOLD, "1. Instruções dos agentes"))
    run_tool("sync-agents", "--quiet")
    print(c(BOLD, "2. Validação"))
    if run_tool("vault-validate", str(VAULT)) != 0:
        sys.exit(c(RED, "Validação falhou. Corrija antes de sincronizar."))
    if not git("status", "--porcelain").stdout.strip():
        print(c(GREEN, "✓ Nada a sincronizar."))
        return
    git("add", "-A")
    n = len(git("diff", "--cached", "--name-only").stdout.splitlines())
    r = git("commit", "-m", f"docs(vault): auto-sync {n} arquivo(s) ({datetime.now():%Y-%m-%d %H:%M})")
    print(r.stdout or r.stderr)
    g = CFG["git"]
    r = git("push", g["remote"], g["branch"])
    print(c(GREEN, "✓ Vault sincronizado.") if r.returncode == 0 else c(RED, r.stderr))


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("help", "--help", "-h"):
        show_help()
        return 0
    cmd, args = argv[0], argv[1:]
    table = {
        "status": cmd_status, "info": cmd_status, "lint": cmd_lint, "ingest": cmd_ingest,
        "validate": lambda a: run_tool("vault-validate", str(VAULT), *a),
        "health": lambda a: run_tool("vault-health", *a),
        "sources": lambda a: run_tool("vault-sources", *a), "backlog": lambda a: run_tool("vault-sources", *a),
        "search": cmd_search, "new": cmd_new, "create": cmd_new,
        "meta": cmd_meta, "frontmatter": cmd_meta, "outline": cmd_outline, "toc": cmd_outline,
        "section": cmd_section, "links": cmd_links, "open": cmd_open, "change": cmd_change, "log": cmd_log,
        "canvas": lambda a: run_tool("generate-canvas", *a), "sync-agents": lambda a: run_tool("sync-agents", *a),
        "sync": cmd_sync, "auth": cmd_auth, "people": cmd_people,
        "backup": lambda a: run_tool("agent-backup", *a),
    }
    if cmd not in table:
        print(c(RED, f"Comando desconhecido: '{cmd}'\n"))
        show_help()
        return 1
    return table[cmd](args) or 0


if __name__ == "__main__":
    sys.exit(main())
