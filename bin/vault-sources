#!/usr/bin/env python3
"""
vault-sources: Karpathy LLM-Wiki Source Ingestion & Task Backlog Auditor

Audita a Camada 1 (90 - Arquivos/Fontes) contra a Camada 2 (The Compiled Wiki):
1. Detecta arquivos brutos pendentes de ingestão (sem nota de síntese associada).
2. Rastreia referências cruzadas e citações das fontes em notas de pesquisa, mudanças e procedimentos.
3. Extrai e contabiliza tarefas e afazeres (- [ ] / - [x]) contidos nas fontes e nas notas de síntese.
4. Fornece saída interativa colorida, listagem enxuta de pendências ou JSON para agentes de IA.

Uso:
    vault-sources [--vault-path PATH] [--json] [--pending] [--tasks]
"""

import sys
import os
import re
import json
import argparse
from pathlib import Path
from datetime import datetime
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import vaultcfg  # noqa: E402
import functools  # noqa: E402

# ANSI Colors
CYAN = "\033[96m"
GREEN = "\033[92m"
YELLOW = "\033[93m"
RED = "\033[91m"
BOLD = "\033[1m"
DIM = "\033[2m"
RESET = "\033[0m"

TASK_PATTERN = re.compile(r'^\s*-\s*\[([ xX])\]\s*(.+)$')
LINK_PATTERN = re.compile(r'\[\[([^\]|#]+)(?:#[^\]|]+)?(?:\|[^\]]+)?\]\]')
@functools.lru_cache(maxsize=None)
def _cfg(vault_dir):
    return vaultcfg.load(vault_dir)


def P(vault_dir, role):
    """Pasta de um papel relativa ao vault, conforme o mapa de pastas do config."""
    return vaultcfg.fpath(_cfg(str(vault_dir)), role)


def resolve_vault_path(custom_path=None):
    return vaultcfg.vault_dir(custom_path)

def parse_frontmatter(content):
    if not content.startswith("---"):
        return {}
    parts = content.split("---", 2)
    if len(parts) < 3:
        return {}
    raw_yaml = parts[1]
    props = {}
    for line in raw_yaml.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or ":" not in line:
            continue
        key, val = line.split(":", 1)
        key = key.strip()
        val = val.strip().strip("'\"")
        props[key] = val
    return props

def extract_tasks_from_content(content, source_label=""):
    tasks = []
    for line_num, line in enumerate(content.splitlines(), start=1):
        m = TASK_PATTERN.match(line)
        if m:
            is_done = m.group(1).lower() == 'x'
            task_text = m.group(2).strip()
            
            # Identificação de tags, menções e prioridade
            tags = re.findall(r'#[\w/\-]+', task_text)
            assignees = re.findall(r'@\w+', task_text)
            priority = "normal"
            if "⏫" in task_text:
                priority = "high"
            elif "🔼" in task_text:
                priority = "medium"
            elif "🔽" in task_text:
                priority = "low"
            
            # Se for extração de fonte bruta, apenas considerar como tarefa se houver tag, prioridade ou responsável explícito
            if source_label.startswith(tuple(p["sources"] for p in vaultcfg.FOLDER_PRESETS.values())) and not tags and not assignees and priority == "normal":
                continue
            
            tasks.append({
                "line": line_num,
                "completed": is_done,
                "text": task_text,
                "tags": tags,
                "assignees": assignees,
                "priority": priority,
                "source": source_label
            })
    return tasks

def audit_sources(vault_dir):
    sources_dir = vault_dir / P(vault_dir, "sources")
    results = {
        "timestamp": datetime.now().isoformat(),
        "vault_path": str(vault_dir),
        "total_sources": 0,
        "ingested_count": 0,
        "referenced_only_count": 0,
        "pending_count": 0,
        "total_tasks": 0,
        "pending_tasks": 0,
        "completed_tasks": 0,
        "sources": [],
        "tasks": []
    }

    if not sources_dir.is_dir():
        return results

    # 1. Localizar arquivos primários na pasta de fontes
    raw_files = []
    for p in sources_dir.rglob("*"):
        if p.is_file():
            rel = p.relative_to(vault_dir)
            # Ignorar README e arquivos ocultos
            if p.name == "README.md" or p.name.startswith(".") or p.name == ".gitkeep":
                continue
            raw_files.append((p, rel))

    results["total_sources"] = len(raw_files)

    # 2. Varrer todas as notas compiladas da wiki
    md_notes = [p for p in vault_dir.rglob("*.md") if not any(part.startswith(".") or part in ("node_modules", ".venv") for part in p.parts)]
    wiki_notes = []
    for p in md_notes:
        rel = p.relative_to(vault_dir)
        rel_str = rel.as_posix()
        # Excluir a própria pasta de fontes brutas e ferramentas da indexação da wiki
        if rel_str.startswith((P(vault_dir, "sources"), P(vault_dir, "tools"))):
            continue
        try:
            content = p.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            continue
        props = parse_frontmatter(content)
        wiki_notes.append({
            "path": p,
            "rel": rel_str,
            "stem": p.stem,
            "props": props,
            "content": content
        })

    # 3. Cruzar cada arquivo bruto com as notas da wiki
    for raw_path, raw_rel in raw_files:
        rel_str = str(raw_rel)
        filename = raw_path.name
        stem = raw_path.stem
        category_parts = raw_rel.parts[2:-1]
        category = "/".join(category_parts) if category_parts else "General"
        ext = raw_path.suffix.lower()

        synthesis_notes = []
        referenced_in = []

        # Extrair tarefas diretamente do arquivo bruto (se for arquivo de texto/markdown)
        raw_tasks = []
        if ext in [".md", ".txt"]:
            try:
                raw_content = raw_path.read_text(encoding="utf-8", errors="ignore")
                raw_tasks = extract_tasks_from_content(raw_content, source_label=rel_str)
            except Exception:
                pass

        # Buscar notas que referenciam ou sintetizam a fonte
        for note in wiki_notes:
            note_rel = note["rel"]
            props = note["props"]
            content = note["content"]

            is_synthesis = False
            is_ref = False

            raw_source_val = props.get("raw_source", "")
            if raw_source_val:
                if rel_str in raw_source_val or raw_source_val in rel_str:
                    is_synthesis = True
                elif filename in raw_source_val and filename.lower() != "chat.md":
                    is_synthesis = True
                elif filename.lower() == "chat.md" and raw_path.parent.name.lower() in raw_source_val.lower():
                    is_synthesis = True
                elif stem in raw_source_val and len(stem) > 5 and filename.lower() != "chat.md":
                    is_synthesis = True

            # Verifica links wiki diretos ou texto
            if f"[[{rel_str}" in content:
                is_ref = True
            elif filename.lower() != "chat.md" and f"[[{filename}" in content:
                is_ref = True
            elif filename.lower() == "chat.md" and raw_path.parent.name.lower() in content.lower() and "chat.md" in content:
                is_ref = True
            elif stem in content and len(stem) > 8 and filename.lower() != "chat.md":
                is_ref = True

            if is_synthesis:
                synthesis_notes.append(note_rel)
                # Extrai tarefas da nota de síntese compilada também
                synth_tasks = extract_tasks_from_content(content, source_label=note_rel)
                for st in synth_tasks:
                    st["from_synthesis"] = True
                    raw_tasks.append(st)
            elif is_ref:
                referenced_in.append(note_rel)

        # Deduplicar tarefas
        unique_tasks = []
        seen_tasks = set()
        for t in raw_tasks:
            norm_key = t["text"].strip().lower()
            if norm_key not in seen_tasks:
                seen_tasks.add(norm_key)
                unique_tasks.append(t)

        tasks_pending = sum(1 for t in unique_tasks if not t["completed"])
        tasks_completed = sum(1 for t in unique_tasks if t["completed"])

        results["total_tasks"] += len(unique_tasks)
        results["pending_tasks"] += tasks_pending
        results["completed_tasks"] += tasks_completed
        results["tasks"].extend(unique_tasks)

        # Definir status
        if synthesis_notes:
            status = "INGESTED"
            results["ingested_count"] += 1
        elif referenced_in:
            status = "REFERENCED"
            results["referenced_only_count"] += 1
            results["pending_count"] += 1
        else:
            status = "PENDING"
            results["pending_count"] += 1

        file_stat = raw_path.stat()
        results["sources"].append({
            "file": rel_str,
            "filename": filename,
            "category": category,
            "size_bytes": file_stat.st_size,
            "status": status,
            "synthesis_notes": synthesis_notes,
            "referenced_in": referenced_in,
            "tasks_count": len(unique_tasks),
            "tasks_pending": tasks_pending,
            "tasks_completed": tasks_completed,
            "tasks": unique_tasks
        })

    return results

def print_audit_report(results):
    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║     Obsidian Work Vault · Karpathy LLM-Wiki Sources Auditor       ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════╝{RESET}")
    print(f"  {DIM}Vault:{RESET} {results['vault_path']}")
    print(f"  {DIM}Data:{RESET}  {results['timestamp']}\n")

    total = results["total_sources"]
    ingested = results["ingested_count"]
    ref_only = results["referenced_only_count"]
    pending = results["pending_count"]

    print(f"{BOLD}📊 Métricas de Compilação de Fontes:{RESET}")
    print(f"  • Fontes Brutas Totais (Camada 1): {BOLD}{total}{RESET}")
    print(f"  • Fontes Ingeridas (Síntese Criada): {GREEN}{BOLD}{ingested}{RESET} ({ingested/total*100:.1f}%)" if total else "  • Ingeridas: 0")
    print(f"  • Apenas Referenciadas em Changes/Logs: {YELLOW}{BOLD}{ref_only}{RESET}")
    print(f"  • Backlog Pendente de Ingestão: {RED if pending > 0 else GREEN}{BOLD}{pending}{RESET}")
    print(f"  • Tarefas e Afazeres Extraídos: {BOLD}{results['total_tasks']}{RESET} ({YELLOW}{results['pending_tasks']} pendentes{RESET}, {GREEN}{results['completed_tasks']} concluídas{RESET})\n")

    print(f"{BOLD}📑 Tabela de Fontes Brutas e Status:{RESET}")
    print(f"{DIM}{'CATEGORIA':<16} {'STATUS':<12} {'TAREFAS':<10} {'ARQUIVO':<40} {'SÍNTESE COMPILADA'}{RESET}")
    print(f"{DIM}{'-'*105}{RESET}")

    for s in sorted(results["sources"], key=lambda x: (x["status"] == "INGESTED", x["category"], x["filename"])):
        cat = s["category"][:15]
        status = s["status"]
        if status == "INGESTED":
            status_color = f"{GREEN}{status:<12}{RESET}"
        elif status == "REFERENCED":
            status_color = f"{YELLOW}{status:<12}{RESET}"
        else:
            status_color = f"{RED}{status:<12}{RESET}"

        tasks_summary = f"{s['tasks_pending']} pend" if s['tasks_pending'] > 0 else (f"{s['tasks_completed']} ok" if s['tasks_completed'] > 0 else "-")
        tasks_color = f"{YELLOW}{tasks_summary:<10}{RESET}" if s['tasks_pending'] > 0 else f"{DIM}{tasks_summary:<10}{RESET}"
        
        fname = s["filename"]
        if len(fname) > 38:
            fname = fname[:35] + "..."
        
        synth = s["synthesis_notes"][0] if s["synthesis_notes"] else ("(parcial)" if s["referenced_in"] else f"{RED}PENDENTE{RESET}")
        if len(synth) > 35:
            synth = synth[:32] + "..."

        print(f"{cat:<16} {status_color} {tasks_color} {fname:<40} {synth}")

    print("")

    # Se houver pendências, mostrar orientações de ação imediata
    pending_items = [s for s in results["sources"] if s["status"] in ("PENDING", "REFERENCED")]
    if pending_items:
        print(f"{BOLD}{YELLOW}⚠️  Ações Recomendadas para Fontes Pendentes:{RESET}")
        for p in pending_items:
            cat_arg = f'"{p["category"]}"' if p["category"] != "General" else "General"
            print(f"  • {BOLD}{p['file']}{RESET}")
            if p["tasks_pending"] > 0:
                print(f"    {YELLOW}↳ Contém {p['tasks_pending']} tarefa(s) pendente(s) de consolidação na wiki!{RESET}")
            print(f"    Comando: {CYAN}vault ingest \"{p['file']}\" {cat_arg}{RESET}\n")

def print_tasks_report(results):
    print(f"\n{BOLD}{CYAN}╔═══════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{BOLD}{CYAN}║     Tarefas e Afazeres Extraídos de Fontes Brutas & Sínteses      ║{RESET}")
    print(f"{BOLD}{CYAN}╚═══════════════════════════════════════════════════════════════════╝{RESET}\n")

    tasks = results.get("tasks", [])
    if not tasks:
        print(f"{DIM}Nenhuma tarefa encontrada nas fontes brutas ou notas de síntese.{RESET}\n")
        return

    pending = [t for t in tasks if not t["completed"]]
    completed = [t for t in tasks if t["completed"]]

    print(f"{BOLD}⏳ Tarefas Pendentes ({len(pending)}):{RESET}")
    for t in pending:
        raw_text = t['text']
        prio_icon = ""
        if not any(raw_text.startswith(icon) for icon in ("⏫", "🔼", "🔽")):
            prio_icon = "⏫ " if t["priority"] == "high" else ("🔼 " if t["priority"] == "medium" else ("🔽 " if t["priority"] == "low" else ""))
        print(f"  [ ] {prio_icon}{BOLD}{raw_text}{RESET}")
        print(f"      {DIM}Origem: {t['source']}:{t['line']}{RESET}")

    if completed:
        print(f"\n{BOLD}✅ Tarefas Concluídas ({len(completed)}):{RESET}")
        for t in completed:
            print(f"  {GREEN}[x]{RESET} {t['text']} {DIM}({t['source']}){RESET}")
    print("")

def main():
    parser = argparse.ArgumentParser(description="Audita fontes brutas do LLM-Wiki e tarefas pendentes.")
    parser.add_argument("--vault-path", help="Caminho do vault Obsidian")
    parser.add_argument("--json", action="store_true", help="Saída em formato JSON para agentes")
    parser.add_argument("--pending", action="store_true", help="Lista apenas caminhos dos arquivos brutos pendentes")
    parser.add_argument("--tasks", action="store_true", help="Lista detalhada de tarefas e afazeres extraídos")
    args = parser.parse_args()

    vault_dir = resolve_vault_path(args.vault_path)
    results = audit_sources(vault_dir)

    if args.json:
        print(json.dumps(results, indent=2, ensure_ascii=False))
        return

    if args.pending:
        pending_items = [s["file"] for s in results["sources"] if s["status"] in ("PENDING", "REFERENCED")]
        for p in pending_items:
            print(p)
        return

    if args.tasks:
        print_tasks_report(results)
        return

    print_audit_report(results)

if __name__ == "__main__":
    main()
