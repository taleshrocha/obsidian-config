#!/usr/bin/env python3
"""
vault-validate
Validação somente leitura do vault: estrutura, metadados, links, segredos e vaults compartilhados montados.
Verifies structure, metadata, properties, internal links, and secrets scan.
"""

import os
import sys
import re
import json
import subprocess
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
import vaultcfg  # noqa: E402

def _resolve_vault_dir():
    return str(vaultcfg.vault_dir())

VAULT_DIR = None  # resolvido em main()

EXPECTED_DIRS = list(vaultcfg.DEFAULTS["expected_dirs"])

# Vaults compartilhados montados como subpasta (repo git próprio, ignorado pelo .gitignore).
# Regras de caminho valem relativas à raiz do mount.
SHARED_MOUNTS = []  # preenchido por configure() a partir de .vault/config.json
ALLOWED_ROOT = set(vaultcfg.DEFAULTS["allowed_root_entries"])
CFG = {}

def configure(vault_dir):
    global EXPECTED_DIRS, SHARED_MOUNTS, ALLOWED_ROOT, CFG
    cfg = vaultcfg.load(vault_dir)
    CFG = cfg
    EXPECTED_DIRS = list(cfg["expected_dirs"])
    SHARED_MOUNTS = vaultcfg.shared_mount_paths(cfg)
    ALLOWED_ROOT = set(cfg["allowed_root_entries"])


def _rule_path(rel_path):
    """Caminho comparável com os nomes de pasta: sem o mount e sem folders.root."""
    for m in SHARED_MOUNTS:
        if rel_path.startswith(m + "/"):
            return rel_path[len(m) + 1:]
    return vaultcfg.strip_root(CFG, rel_path)


def F(role):
    return vaultcfg.fname(CFG, role)

VALID_ENVIRONMENTS = {"production", "homologation", "testing", "development", "local"}

def parse_frontmatter(file_path):
    """Simple robust YAML frontmatter parser without requiring external PyYAML."""
    with open(file_path, "r", encoding="utf-8", errors="ignore") as f:
        content = f.read()
    
    if not content.startswith("---"):
        return None, content
    
    parts = content.split("---", 2)
    if len(parts) < 3:
        return None, content
    
    raw_yaml = parts[1]
    body = parts[2]
    props = {}
    for line in raw_yaml.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if ":" in line:
            key, val = line.split(":", 1)
            key = key.strip()
            val = val.strip().strip("'\"")
            props[key] = val
    return props, body

def check_structure(vault_dir):
    errors = []
    for d in EXPECTED_DIRS:
        dp = os.path.join(vault_dir, d)
        if not os.path.isdir(dp):
            errors.append(f"Missing expected directory: {d}")
    
    # Check for stray files at root other than allowed dotfiles or standard markdown
    allowed_root = ALLOWED_ROOT
    for item in os.listdir(vault_dir):
        if item in allowed_root or item in {m.split("/")[0] for m in SHARED_MOUNTS}:
            continue
        if item.startswith(".") and subprocess.run(["git", "-C", str(vault_dir), "check-ignore", "-q", item],
                                                  capture_output=True).returncode == 0:
            continue  # artefato local ignorado pelo git (IDE, cache)
        ip = os.path.join(vault_dir, item)
        if os.path.isdir(ip):
            if item not in [d.split("/")[0] for d in EXPECTED_DIRS]:
                errors.append(f"Unexpected top-level directory: {item}")
        elif os.path.isfile(ip):
            if not item.endswith((".md", ".base", ".canvas")):
                errors.append(f"Unexpected top-level file: {item}")
            elif item.startswith(("Sem título", "Untitled")):
                errors.append(f"Untitled temporary file at root: {item}. Please name it meaningfully.")

    # Check that Obsidian settings ignore runtime vendor directories
    app_json_path = os.path.join(vault_dir, ".obsidian", "app.json")
    if os.path.isfile(app_json_path):
        try:
            with open(app_json_path, "r", encoding="utf-8") as f:
                app_data = json.load(f)
            filters = app_data.get("userIgnoreFilters", [])
            if not any("node_modules" in filt for filt in filters):
                errors.append(".obsidian/app.json must include 'node_modules' in userIgnoreFilters to prevent vendor markdown pollution in Graph View.")
        except Exception:
            pass

    return errors

def check_files(vault_dir):
    prop_errors = []
    change_errors = []
    server_errors = []
    secret_errors = []
    
    all_files = []
    known_notes = set()
    
    secret_patterns = [
        re.compile(r"-----BEGIN (?:RSA |EC |DSA |OPENSSH )?PRIVATE KEY-----"),
        re.compile(r"(?i)(?:password|senha|secret|api_key)\s*[:=]\s*['\"](?!(?:\[REDACTED\]|<[^>]+>|dummy|changeme|teste|123|default|))([a-zA-Z0-9_\-\.\$]{12,})['\"]"),
        re.compile(r"ghp_[a-zA-Z0-9]{36}"),
        re.compile(r"glpat-[a-zA-Z0-9\-_]{20,}"),
        re.compile(r"AKIA[0-9A-Z]{16}")
    ]

    for root, dirs, files in os.walk(vault_dir):
        # Ignore hidden directories (.git, .obsidian, .venv, etc.) and node_modules
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
            
        for file in files:
            if not file.endswith(".md"):
                # Anexos (imagens, PDFs, canvas) são alvos válidos de [[...]] pelo nome com extensão
                known_notes.add(file)
                known_notes.add(os.path.relpath(os.path.join(root, file), vault_dir).replace(os.sep, "/"))
                continue
            if file.endswith(".md"):
                full_path = os.path.join(root, file)
                rel_path = os.path.relpath(full_path, vault_dir).replace(os.sep, "/")  # "/" em qualquer sistema
                all_files.append((rel_path, full_path))
                
                # Note names for link checking
                base_name = os.path.splitext(file)[0]
                known_notes.add(base_name)
                known_notes.add(rel_path)
                known_notes.add(os.path.splitext(rel_path)[0])
                # Directory names can also be valid link targets
                dir_name = os.path.dirname(rel_path).replace(os.sep, "/")
                if dir_name:
                    known_notes.add(dir_name)
                    known_notes.add(dir_name + "/")

    for rel_path, full_path in all_files:
        rule_path = _rule_path(rel_path)
        is_template = rule_path.startswith(F("templates") + "/")
        props, body = parse_frontmatter(full_path)
        
        # Secret scan (run on all files including templates; notas em privacy_exempt_paths ficam de fora)
        with open(full_path, "r", encoding="utf-8", errors="ignore") as f:
            full_content = f.read()
            for pat in ([] if privacy_exempt(_rule_path(rel_path)) else secret_patterns):
                match = pat.search(full_content)
                if match:
                    secret_errors.append(f"{rel_path}: Potentially exposed secret detected: {match.group(0)[:15]}...")

        is_excalidraw = rel_path.endswith(".excalidraw.md") or (props and "excalidraw-plugin" in props)
        is_raw_source = rule_path.startswith(F("sources") + "/")
        is_agent_contract = rule_path in {"CLAUDE.md", "GEMINI.md", "AGENTS.md", "README.md"}
        if is_template or is_excalidraw or is_raw_source or is_agent_contract:
            # Skip property content checks for template, Excalidraw, raw sources, and root agent contracts
            continue
            
        if props is None:
            prop_errors.append(f"{rel_path}: Missing YAML frontmatter")
            continue
            
        if "type" not in props or not props["type"]:
            prop_errors.append(f"{rel_path}: Missing 'type' property in frontmatter")

        # Change metadata check
        if rule_path.startswith(F("changes") + "/"):
            if "id" not in props or not props["id"]:
                change_errors.append(f"{rel_path}: Change missing 'id'")
            if "date" not in props or not props["date"]:
                change_errors.append(f"{rel_path}: Change missing 'date'")
            if "status" not in props or not props["status"]:
                change_errors.append(f"{rel_path}: Change missing 'status'")
            if not ("server" in props or "project" in props or "service" in props):
                change_errors.append(f"{rel_path}: Change missing 'server', 'project' or 'service'")

        # Server metadata check
        if rule_path.startswith(F("servers") + "/"):
            if props.get("type") != "server":
                server_errors.append(f"{rel_path}: type must be 'server', got '{props.get('type')}'")
            env = props.get("environment")
            if not env:
                server_errors.append(f"{rel_path}: Server missing 'environment'")
            elif env not in VALID_ENVIRONMENTS:
                server_errors.append(f"{rel_path}: Invalid environment '{env}', expected one of {VALID_ENVIRONMENTS}")

    # Check internal links
    link_errors = []
    link_pattern = re.compile(r"\[\[([^\]|#]+)(?:#[^\]|]*)?(?:\|[^\]]*)?\]\]")
    code_block_pattern = re.compile(r"```[\s\S]*?```")
    inline_code_pattern = re.compile(r"`[^`\n]+`")

    for rel_path, full_path in all_files:
        if _rule_path(rel_path).startswith(F("templates") + "/"):
            continue
        with open(full_path, "r", encoding="utf-8", errors="ignore") as f:
            content = f.read()

        # Remove fenced code blocks and inline code spans to avoid false positives on syntax examples
        content_no_code = code_block_pattern.sub("", content)
        content_no_code = inline_code_pattern.sub("", content_no_code)

        for match in link_pattern.finditer(content_no_code):
            target = match.group(1).strip()
            # Ignore template placeholders like {{...}} or placeholders like CHG-... or INC-...
            if target.startswith("{{") or target.startswith("CHG-...") or target.startswith("INC-...") or target.startswith("ADR-..."):
                continue
            if target not in known_notes:
                # check if file exists directly relative or with .md
                p1 = os.path.join(vault_dir, target)
                p2 = os.path.join(vault_dir, target + ".md")
                if not (os.path.exists(p1) or os.path.exists(p2)):
                    link_errors.append(f"{rel_path}: Broken internal link -> [[{target}]]")

    return prop_errors, change_errors, server_errors, link_errors, secret_errors

def check_shared_mounts(vault_dir):
    """Vault compartilhado montado: roda o validador do time e o guard contra vazamento
    de conteúdo pessoal. Falha aqui bloqueia commit e encerramento do vault pessoal."""
    errors = []
    guard = Path(__file__).resolve().parent / "shared-vault-guard"
    for m in SHARED_MOUNTS:
        shared = Path(vault_dir) / m
        if not shared.is_dir():
            continue
        if (shared / ".vault" / "config.json").is_file():
            env_m = os.environ.copy()
            env_m["OBSIDIAN_VAULT_PATH"] = str(shared)
            res = subprocess.run([sys.executable, "-X", "utf8", str(Path(__file__).resolve()), str(shared)], capture_output=True, text=True, env=env_m)
            if res.returncode != 0:
                errors.append(f"{m}: vault-validate do mount falhou:")
                errors += [f"    {l}" for l in res.stdout.splitlines() if l.strip().startswith(("-", "✗"))]
        if guard.is_file():
            env = os.environ.copy()
            env["OBSIDIAN_VAULT_PATH"] = str(vault_dir)
            res = subprocess.run([sys.executable, "-X", "utf8", str(guard), str(shared)], capture_output=True, text=True, env=env)
            if res.returncode != 0:
                errors += [f"    {l}" for l in res.stdout.splitlines() if l.strip()]
    return errors

EMAIL_RE = re.compile(r"[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}")
EMAIL_ALLOWED = re.compile(r"^git@|@(?:example\.(?:com|org|net)|exemplo\.com|dominio\.com)$", re.I)
PHONE_RE = re.compile(r"\(?\b\d{2}\)?\s?9?\d{4}-\d{4}\b")
HOME_PATH_RE = re.compile(r"(?:/home/([a-z_][\w.-]*)|/Users/([A-Za-z][\w.-]*)|C:\\Users\\(\w+))")


def privacy_exempt(rel):
    """Notas isentas por decisão explícita do time (privacy_exempt_paths no config)."""
    return any(rel == p or rel.startswith(p.rstrip("/") + "/") for p in CFG.get("privacy_exempt_paths", []))
PW_LINE_RE = re.compile(r"(?i)\b(?:senha|password|passwd|pwd)\b")
CODE_SPAN_RE = re.compile(r"`([^`\n]+)`")
WEAK_PW_RE = re.compile(r"(?i)^(?:senha|password|pass|admin|root|teste?)[@#!_.-]?\d+$|^\d{3,}$")
SAFE_SPAN_RE = re.compile(r"^(?:\[REDACTED\]|<[^>]+>|\$\{?[A-Z_][A-Z0-9_]*\}?)$")

def check_privacy(vault_dir):
    """Bloqueia dados que não podem estar num vault de time:
    consultas Dataview sem escopo (leem o vault hospedeiro quando montado como subpasta),
    DataviewJS, e-mails e telefones reais, caminhos de home e senhas literais."""
    errors = []
    for root, dirs, files in os.walk(vault_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
        for file in files:
            if not file.endswith((".md", ".canvas", ".base")):
                continue
            full = os.path.join(root, file)
            rel = os.path.relpath(full, vault_dir).replace(os.sep, "/")
            if privacy_exempt(rel):
                continue
            with open(full, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()

            # Dataview: só DQL com escopo relativo a this.file.folder
            if re.search(r"```dataviewjs|`\$=", content):
                errors.append(f"{rel}: DataviewJS é proibido (lê qualquer nota do vault hospedeiro)")
            if re.search(r"`=\s", content):
                errors.append(f"{rel}: consulta Dataview inline é proibida (sem escopo)")
            for block in re.findall(r"```dataview\n([\s\S]*?)```", content):
                if re.search(r'(?i)\bFROM\s+(?:"[^"]+"|#|\[\[)', block):
                    errors.append(f"{rel}: Dataview com FROM de pasta, tag ou link. Use FROM \"\" + WHERE com this.file.folder")
                if "this.file.folder" not in block:
                    errors.append(f"{rel}: Dataview sem escopo this.file.folder (leria o vault hospedeiro)")

            for n, line in enumerate(content.splitlines(), 1):
                for m in EMAIL_RE.finditer(line):
                    if not EMAIL_ALLOWED.search(m.group(0)):
                        errors.append(f"{rel}:{n}: e-mail real ({m.group(0)[:3]}...). Use papel/perfil ou usuario@example.com")
                if PHONE_RE.search(line):
                    errors.append(f"{rel}:{n}: número de telefone")
                allowed_homes = set(CFG.get("privacy_allow_home_users", []))
                for hm in HOME_PATH_RE.finditer(line):
                    user = next((g for g in hm.groups() if g), "")
                    if user not in allowed_homes:
                        errors.append(f"{rel}:{n}: caminho de home pessoal ({user}). Use uma variável como $<TIME>_REPOS, ou libere contas de servidor em privacy_allow_home_users")
                        break
                if PW_LINE_RE.search(line):
                    for span in CODE_SPAN_RE.findall(line):
                        s = span.strip()
                        if SAFE_SPAN_RE.match(s) or "/" in s or s.startswith((".", "~")) or EMAIL_ALLOWED.search(s):
                            continue
                        assigned = re.search(r"(?i)(?:senha|password|passwd|pwd)\W{0,3}[:=]\s*`" + re.escape(span) + "`", line)
                        looks_secret = re.search(r"\d", s) and " " not in s and len(s) <= 64
                        if WEAK_PW_RE.match(s) or assigned or looks_secret:
                            errors.append(f"{rel}:{n}: possível senha literal em linha que fala de senha. Use [REDACTED]")
    return errors

# Conteúdo oculto: instrução que o agente lê e o humano não vê (Unicode invisível, comentário HTML,
# texto escondido por CSS, blob base64). Arquivos de instrução têm varredura estrita.
BIDI_TAG_RE = re.compile("[؜‪-‮⁦-⁩\U000e0000-\U000e007f]")
INVISIBLE_RE = re.compile("[­᠎​‌‎‏⁠-⁤﻿]")
ZWJ = "‍"
HTML_COMMENT_RE = re.compile(r"<!--([\s\S]*?)-->")
MANAGED_COMMENT_RE = re.compile(r"^\s*(?:obsidian-config:(?:begin|end)|Canonical-Policy-SHA256:[^\n]*)\s*$")
SUSPICIOUS_RE = re.compile(  # privacy-gate: allow
    r"(?i)\b(?:ignore|disregard|forget|ignor[ea]r?|esque[cç]a)\b.{0,40}\b(?:previous|above|prior|instructions?|rules|anteriores?|instru[cç]|regras)"
    r"|\b(?:you are|act as|você é|voce e|aja como)\b.{0,30}\b(?:assistant|agent|ai|agente|ia|model)\b"
    r"|system prompt|prompt do sistema|<\s*/?\s*(?:system|instructions?|assistant|user)\s*>"
    r"|\b(?:do not|don't|não|nao)\s+(?:tell|mention|reveal|show|conte|mencione|revele|mostre|informe)"
    r"|\b(?:curl|wget|bash -c|sh -c|powershell|iex|eval)\b|\bbase64\b|https?://"
    r"|\b(?:send|post|upload|exfiltrat\w*|envie|mande|poste)\b.{0,40}\b(?:token|password|secret|senha|credencia\w*|chave|key)")
HIDDEN_CSS_RE = re.compile(r"(?i)<[a-z][^>]*(?:\shidden[\s>=]|style\s*=\s*['\"][^'\"]*(?:display\s*:\s*none|visibility\s*:\s*hidden|"
                           r"font-size\s*:\s*0|opacity\s*:\s*0(?:\.0+)?\s*(?:;|['\"])|color\s*:\s*(?:white|#fff\b|#ffffff)))")
BASE64_RE = re.compile(r"(?<![A-Za-z0-9+/=,])[A-Za-z0-9+/]{%d,}={0,2}")
FENCE_RE = re.compile(r"```[\s\S]*?```|`[^`\n]+`")
STRICT_NAMES = {"AGENTS.md", "CLAUDE.md", "GEMINI.md"}


def _is_strict(rule_path):
    return (rule_path in STRICT_NAMES or rule_path.startswith(F("templates") + "/") or rule_path == ".vault/config.json"
            or rule_path == vaultcfg.strip_root(CFG, CFG.get("policy_note", "")))


def _b64_blobs(text, min_len):
    for m in re.finditer(BASE64_RE.pattern % min_len, text):
        s = m.group(0)
        # base64 de verdade mistura maiúscula, minúscula e dígito; hash hex e palavras não
        if re.search(r"[A-Z]", s) and re.search(r"[a-z]", s) and re.search(r"\d", s):
            yield s


def hidden_content_errors(rel, text, rule_path):
    errors = []
    raw_source = rule_path.startswith(F("sources") + "/")
    strict = _is_strict(rule_path)
    for n, line in enumerate(text.splitlines(), 1):
        for m in BIDI_TAG_RE.finditer(line):
            errors.append(f"{rel}:{n}: caractere Unicode de controle bidi/tag U+{ord(m.group(0)):04X} (esconde texto do revisor)")
            break
        if raw_source:
            continue
        for m in INVISIBLE_RE.finditer(line):
            if m.group(0) == "﻿" and n == 1 and m.start() == 0:
                continue
            errors.append(f"{rel}:{n}: caractere invisível U+{ord(m.group(0)):04X}. Remova")
            break
        for i, ch in enumerate(line):
            if ch == ZWJ and (i == 0 or ord(line[i - 1]) < 0x2190 or strict):
                errors.append(f"{rel}:{n}: zero-width joiner fora de emoji. Remova")
                break
    if raw_source or rel.endswith(".excalidraw.md") or not rel.endswith(".md"):
        return errors
    visible = FENCE_RE.sub("", text)
    for m in HTML_COMMENT_RE.finditer(visible):
        body = m.group(1)
        if MANAGED_COMMENT_RE.match(body):
            continue
        if strict:
            errors.append(f"{rel}: comentário HTML em arquivo de instrução de agente. Escreva o texto visível ou remova")
        elif SUSPICIOUS_RE.search(body):
            errors.append(f"{rel}: comentário HTML com texto dirigido a agente ou comando ({body.strip()[:40]!r}). Remova")
    if HIDDEN_CSS_RE.search(visible):
        errors.append(f"{rel}: texto escondido por HTML/CSS (hidden, display:none, cor branca, fonte 0). Remova")
    for blob in _b64_blobs(text, 60 if strict else 100):
        errors.append(f"{rel}: bloco base64 de {len(blob)} caracteres ({blob[:12]}...). Instrução codificada passa despercebida; remova ou mova para {F('sources')}")
        break
    return errors


def check_hidden_content(vault_dir):
    errors = []
    targets = []
    for root, dirs, files in os.walk(vault_dir):
        dirs[:] = [d for d in dirs if not d.startswith(".") and d != "node_modules"]
        targets += [os.path.join(root, f) for f in files if f.endswith((".md", ".canvas", ".base"))]
    targets += [str(p) for p in [Path(vault_dir, ".vault", "config.json"),
                                 *(Path(vault_dir, m, ".vault", "config.json") for m in SHARED_MOUNTS)] if p.is_file()]
    for full in targets:
        rel = os.path.relpath(full, vault_dir).replace(os.sep, "/")
        with open(full, "r", encoding="utf-8", errors="ignore") as f:
            errors += hidden_content_errors(rel, f.read(), _rule_path(rel))
    return errors


def check_agent_imports(vault_dir):
    """Vault que mantém o próprio AGENTS.md: CLAUDE.md e GEMINI.md precisam importá-lo."""
    errors = []
    if not os.path.isfile(os.path.join(vault_dir, "AGENTS.md")):
        return ["AGENTS.md ausente na raiz"]
    for name in ("CLAUDE.md", "GEMINI.md"):
        p = os.path.join(vault_dir, name)
        if not os.path.isfile(p):
            errors.append(f"{name} ausente na raiz")
        elif "@AGENTS.md" not in open(p, encoding="utf-8").read():
            errors.append(f"{name} precisa importar @AGENTS.md")
    return errors


def check_agent_sync(vault_dir):
    """Verifies that vault root agent instruction files (CLAUDE.md, GEMINI.md, AGENTS.md)
    exist and are synchronized with Shared Agent Policy.md."""
    sync_agents_bin = Path(__file__).resolve().parent / "sync-agents"
    if not sync_agents_bin.is_file():
        return [f"sync-agents script not found at {sync_agents_bin}"]
    
    env = os.environ.copy()
    env["OBSIDIAN_VAULT_PATH"] = str(vault_dir)
    res = subprocess.run([sys.executable, "-X", "utf8", str(sync_agents_bin), "--check-vault-only"], env=env, capture_output=True, text=True)
    if res.returncode != 0:
        msg = res.stdout.strip() or res.stderr.strip()
        lines = [line.strip() for line in msg.splitlines() if line.strip()]
        return ["Agent instruction files desynchronized with Shared Agent Policy.md:"] + [f"    {l}" for l in lines] + ["    👉 Fix by running: vault sync-agents"]
    return []

ORG_FOLDERS = ["projects", "repositories", "servers", "services", "applications", "procedures", "research", "tools"]


def _note_date(path, props):
    m = re.search(r"(\d{4})-(\d{2})-\d{2}", path.name)
    if m:
        return m.group(1), m.group(2)
    m = re.match(r"(\d{4})-(\d{2})-\d{2}", (props or {}).get("date", ""))
    return (m.group(1), m.group(2)) if m else None


def check_layout(vault_dir):
    """Organização das pastas: sem pasta de organização desnecessária, AAAA/MM nas pastas de data,
    uma nota de pessoa por autor. Só vale onde o vault declara (vault de time ou `layout`)."""
    errors = []
    root = Path(vault_dir)
    layout = CFG.get("layout", {})
    strict_orgs = layout.get("org_subfolders") is False or (layout.get("org_subfolders") is None and CFG.get("shared_repo"))
    if strict_orgs and not vaultcfg.org_subfolders(CFG):
        orgs = {o.lower() for o in vaultcfg.real_orgs(CFG)}
        for folder in (vaultcfg.fpath(CFG, r) for r in ORG_FOLDERS):
            base = root / folder
            if base.is_dir():
                for sub in sorted(p for p in base.iterdir() if p.is_dir() and p.name.lower() in orgs):
                    errors.append(f"{folder}/{sub.name}: pasta de organização desnecessária (vault de uma só organização). Mova as notas para {folder}/")
    journal = CFG.get("journal", {})
    for folder in layout.get("date_folders", []):
        base = root / folder
        if not base.is_dir():
            continue
        for f in sorted(base.rglob("*.md")):
            rel_parts = f.relative_to(base).parts
            if f.name.lower() in ("readme.md", "index.md"):
                continue
            props, _ = parse_frontmatter(str(f))
            d = _note_date(f, props)
            if not d:
                continue
            skip = 1 if (folder == journal.get("dir") and journal.get("per_author")) else 0
            expected = (d[0], d[1])
            actual = tuple(rel_parts[skip:skip + 2])
            if len(rel_parts) != skip + 3 or actual != expected:
                errors.append(f"{f.relative_to(root).as_posix()}: deve ficar em {folder}/" + ("<autor>/" if skip else "") + f"{d[0]}/{d[1]}/")
    pdir = vaultcfg.people_dir(CFG)
    if pdir:
        authors = set()
        if journal.get("per_author"):
            jd = root / journal.get("dir", "")
            if jd.is_dir():
                authors |= {p.name for p in jd.iterdir() if p.is_dir()}
        changes = vaultcfg.fdir(CFG, "changes")
        for f in changes.rglob("*.md") if changes.is_dir() else []:
            props, _ = parse_frontmatter(str(f))
            if props and props.get("author"):
                authors.add(props["author"])
        for slug in sorted(authors):
            if not vaultcfg.find_person(CFG, slug):
                errors.append(f"autor '{slug}' sem nota de pessoa em {layout['people_dir']}/. Rode: vault people sync")
    return errors


DUP_IGNORE_DIRS = {p[r] for p in vaultcfg.FOLDER_PRESETS.values() for r in ("templates", "files")} | {"node_modules", ".git", ".obsidian", ".obsidian-config", ".claude", ".gemini",
                   ".vault", ".trash", ".mirrors", ".github"}
DUP_IGNORE_NAMES = {"agents.md", "claude.md", "gemini.md", "readme.md", "chat.md"}


def check_duplicate_names(vault_dir):
    """Vault com vaults de time montados: o Obsidian resolve [[Nome]] pelo vault inteiro. Duas notas com o
    mesmo nome em vaults diferentes fazem o link cair na errada (ex.: a mesma pessoa em dois times)."""
    if not SHARED_MOUNTS:
        return []
    root = Path(vault_dir)
    mounts = {root / m for m in SHARED_MOUNTS}
    seen = {}
    for base in [root, *mounts]:
        if not base.is_dir():
            continue
        for dirpath, dirs, files in os.walk(base):
            d = Path(dirpath)
            dirs[:] = [x for x in dirs if x not in DUP_IGNORE_DIRS and (d / x) not in mounts and not x.startswith(".")]
            for name in files:
                if not name.endswith(".md") or name.lower() in DUP_IGNORE_NAMES or re.match(r"\d{4}-\d{2}-\d{2}\.md$", name):
                    continue
                seen.setdefault(name, []).append((d / name).relative_to(root).as_posix())
    errors = []
    for name, paths in sorted(seen.items()):
        roots = {p.split("/", 2)[1] if p.startswith(tuple(m + "/" for m in SHARED_MOUNTS)) else "" for p in paths}
        if len(paths) > 1 and len(roots) > 1:
            errors.append(f"nome ambíguo entre vaults '{name}': " + ", ".join(paths) + ". Renomeie (ex.: 'Nome (Org)') para o link não cair na nota errada")
    return errors


def main():
    vault_dir = sys.argv[1] if len(sys.argv) > 1 else _resolve_vault_dir()
    configure(vault_dir)
    print("Obsidian Vault Validation")
    print(f"Target: {vault_dir}\n")

    if not os.path.isdir(vault_dir):
        print(f"FAIL: Vault directory does not exist: {vault_dir}")
        sys.exit(1)

    all_passed = True

    # 1. Structure
    struct_errs = check_structure(vault_dir)
    if not struct_errs:
        print("✓ Structure")
    else:
        print("✗ Structure")
        for e in struct_errs:
            print(f"  - {e}")
        all_passed = False

    # 2-6. Content Checks
    prop_errs, chg_errs, srv_errs, link_errs, sec_errs = check_files(vault_dir)

    if not prop_errs:
        print("✓ Required properties")
    else:
        print("✗ Required properties")
        for e in prop_errs:
            print(f"  - {e}")
        all_passed = False

    if not chg_errs:
        print("✓ Change metadata")
    else:
        print("✗ Change metadata")
        for e in chg_errs:
            print(f"  - {e}")
        all_passed = False

    if not srv_errs:
        print("✓ Server metadata")
    else:
        print("✗ Server metadata")
        for e in srv_errs:
            print(f"  - {e}")
        all_passed = False

    if not link_errs:
        print("✓ Internal links")
    else:
        print("✗ Internal links")
        for e in link_errs:
            print(f"  - {e}")
        all_passed = False

    if not sec_errs:
        print("✓ Secret scan")
    else:
        print("✗ Secret scan")
        for e in sec_errs:
            print(f"  - {e}")
        all_passed = False

    # 6. Conteúdo oculto (prompt injection)
    hidden_errs = check_hidden_content(vault_dir)
    if not hidden_errs:
        print("✓ Hidden content scan")
    else:
        print("✗ Hidden content scan")
        for e in hidden_errs:
            print(f"  - {e}")
        all_passed = False

    # 6a. Privacidade (vaults de time)
    if CFG.get("privacy_checks"):
        priv_errs = check_privacy(vault_dir)
        if not priv_errs:
            print("✓ Privacy scan")
        else:
            print("✗ Privacy scan")
            for e in priv_errs:
                print(f"  - {e}")
            all_passed = False

    # 6b. Shared vault mounts (privacidade e vazamento do vault pessoal)
    mount_errs = check_shared_mounts(vault_dir) + check_duplicate_names(vault_dir)
    if not mount_errs:
        print("✓ Shared vault mounts")
    else:
        print("✗ Shared vault mounts")
        for e in mount_errs:
            print(f"  - {e}")
        all_passed = False

    # 6c. Layout (pastas de organização, AAAA/MM, notas de pessoa)
    layout_errs = check_layout(vault_dir)
    if not layout_errs:
        print("✓ Layout")
    else:
        print("✗ Layout")
        for e in layout_errs:
            print(f"  - {e}")
        all_passed = False

    # 7. Agent instructions synchronization
    agent_sync_errs = check_agent_sync(vault_dir) if CFG.get("generate_agent_files", True) else check_agent_imports(vault_dir)
    if not agent_sync_errs:
        print("✓ Agent instructions sync")
    else:
        print("✗ Agent instructions sync")
        for e in agent_sync_errs:
            print(f"  - {e}")
        all_passed = False

    print()
    if all_passed:
        print("PASS")
        sys.exit(0)
    else:
        print("FAIL")
        sys.exit(1)

if __name__ == "__main__":
    main()
